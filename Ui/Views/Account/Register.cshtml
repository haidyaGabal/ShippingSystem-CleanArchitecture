@model BL.DTOs.UserDTO
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Customer Registration</h1>
                <a href="index.html" title="Home">Home</a> / Customer Registration
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<div class="wshipping-content-block">
    <div class="container">
        <div class="customer-login">
            <div class="row">
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-left">
                        <div class="login-icon"><i class="fa fa-unlock-alt"></i></div>
                        <h4>Welcome To new account</h4>
                        <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        <a href="#">If you have account already, please login in</a>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-block">
                        <h2>Registration</h2>


                        <form asp-controller="Account"
                              asp-action="Register"
                              method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- First + Last Name -->
                            <div class="row mb-3">
                                <div class="col-md-6 position-relative">
                                    <label asp-for="FirstName"></label>
                                    <i class="fa fa-user position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="FirstName" class="form-control ps-5" placeholder="First Name" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 position-relative">
                                    <label asp-for="LastName"></label>
                                    <i class="fa fa-user position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="LastName" class="form-control ps-5" placeholder="Last Name" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Email + Phone -->
                            <div class="row mb-3">
                                <div class="col-md-6 position-relative">
                                    <label asp-for="Email"></label>
                                    <i class="fa fa-envelope position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="Email" class="form-control ps-5" placeholder="Email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 position-relative">
                                    <label asp-for="Phone"></label>
                                    <i class="fa fa-phone position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="Phone" class="form-control ps-5" placeholder="Phone" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="row mb-3">
                                <div class="col-md-6 position-relative">
                                    <label asp-for="Password"></label>
                                    <i class="fa fa-lock position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="Password" type="password" class="form-control ps-5" placeholder="Password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 position-relative">
                                    <label asp-for="ConfirmPassword"></label>
                                    <i class="fa fa-lock position-absolute ms-3 mt-2 text-muted"></i>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control ps-5" placeholder="Confirm Password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Register
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>