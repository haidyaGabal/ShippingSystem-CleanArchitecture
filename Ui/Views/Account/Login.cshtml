@model BL.DTOs.LoginDTO


<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Customer Login</h1>
                <a href="index.html" title="Home">Home</a> / Customer Login
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<div class="wshipping-content-block">
    <div class="container">
        <div class="customer-login">
            <div class="row">

                <!-- Left Side -->
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-left">
                        <div class="login-icon"><i class="fa fa-lock"></i></div>
                        <h4>Welcome To your account</h4>
                        <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                        <a asp-controller="Account" asp-action="Register">Create A new Account</a>
                    </div>
                </div>

                <!-- Right Side (FORM) -->
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-block">
                        <h2>Login To Your Account</h2>

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                     

                            <!-- Validation -->
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <!-- Email -->
                            <div class="form-group">
                                <label asp-for="Email"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <!-- Password -->
                            <div class="form-group">
                                <label asp-for="Password"></label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <!-- Remember + Forgot -->
                            <div class="checkbox d-flex justify-content-between align-items-center">
                             

                                <a asp-controller="Account"
                                   asp-action="ForgotPassword"
                                   class="forgot-pass">
                                    Forgot your password?
                                </a>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="btn btn-submit mt-3">
                                Login
                            </button>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}