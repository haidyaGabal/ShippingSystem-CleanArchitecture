@model List<ShipmentDTO>

<!-- Breadcrumbs Start -->

<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">

    ```
    <div class="container">

        <div class="row">

            <div class="col-12 col-lg-7">

                <h1>
                    Shipment History
                </h1>

                <a asp-controller="Home"
                   asp-action="Index"
                   title="Home">

                    Home

                </a>

                / Shipment History

            </div>


            <div class="col-12 col-lg-5 text-right">

                <h4>

                    We freight to all over the world.
                    The best logistic company,

                    <span>FAST</span>
                    and
                    <span>SAFELY!</span>

                </h4>

            </div>

        </div>

    </div>
    ```

</div>
<!-- Breadcrumbs End -->
<!-- Shipment History Start -->

<div class="wshipping-content-block">

    ```
    <div class="container">

        <div class="row">


            <!-- Main Content -->
            <div class="col-12 col-lg-9">

                <div class="order-list">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>

                            <h3>
                                Your Shipment History
                            </h3>

                            <p>
                                View and track all your shipments.
                            </p>

                        </div>


                        <a asp-controller="Shipment"
                           asp-action="Create"
                           class="wshipping-button">

                            <i class="fa fa-plus"></i>
                            New Shipment

                        </a>

                    </div>


                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">

                            <table class="table">

                                <thead>

                                    <tr>

                                        <th>
                                            Tracking Number
                                        </th>

                                        <th>
                                            Shipping Date
                                        </th>

                                        <th>
                                            Sender
                                        </th>

                                        <th>
                                            Receiver
                                        </th>

                                        <th>
                                            Shipping Rate
                                        </th>

                                        <th>
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var shipment in Model)
                                    {
                                        <tr>

                                            <!-- Tracking Number -->
                                            <td>

                                                <strong>

                                                    @if (shipment.TrackingNumber.HasValue)
                                                    {
                                                        @shipment.TrackingNumber
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            N/A
                                                        </span>
                                                    }

                                                </strong>

                                            </td>


                                            <!-- Shipping Date -->
                                            <td>

                                                @shipment.ShippingDate
                                                .ToString("dd MMM yyyy")

                                            </td>


                                            <!-- Sender -->
                                            <td>

                                                @if (shipment.Sender != null)
                                                {
                                                    <span>

                                                        @shipment.Sender.SenderName

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        N/A
                                                    </span>
                                                }

                                            </td>


                                            <!-- Receiver -->
                                            <td>

                                                @if (shipment.Receiver != null)
                                                {
                                                    <span>

                                                        @shipment.Receiver.ReceiverName

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        N/A
                                                    </span>
                                                }

                                            </td>


                                            <!-- Shipping Rate -->
                                            <td>

                                                @shipment.ShipingRate.ToString("C")

                                            </td>


                                            <!-- Action -->
                                            <td>

                                                <a asp-controller="Shipment"
                                                   asp-action="Details"
                                                   asp-route-id="@shipment.Id"
                                                   title="View Shipment Details">

                                                    <i class="fa fa-eye"
                                                       aria-hidden="true">
                                                    </i>

                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center">

                            <i class="fa fa-truck fa-3x">
                            </i>

                            <h4>
                                No Shipments Found
                            </h4>

                            <p>
                                You have not created any shipments yet.
                            </p>

                            <a asp-controller="Shipment"
                               asp-action="Create"
                               class="wshipping-button">

                                Create Your First Shipment

                            </a>

                        </div>
                    }

                </div>

            </div>


            <!-- Right Sidebar Start -->
            <div class="col-12 col-lg-3">

                <div class="right-block left-menu menu-with-title mt60 mb15">

                    <h4 class="title-with-bg">

                        Shipment Services

                    </h4>


                    <ul>

                        <li class="active">

                            <a href="#"
                               title="Track Shipment">

                                <i class="fa fa-map-marker">
                                </i>

                                Track Shipment

                            </a>

                        </li>


                        <li>

                            <a href="#"
                               title="Shipment History">

                                <i class="fa fa-history">
                                </i>

                                Shipment History

                            </a>

                        </li>


                        <li>

                            <a asp-controller="Shipment"
                               asp-action="Create"
                               title="Create Shipment">

                                <i class="fa fa-plus">
                                </i>

                                Create Shipment

                            </a>

                        </li>

                    </ul>

                </div>


                <a asp-controller="Shipment"
                   asp-action="Create"
                   class="order-list-button">

                    Create New Shipment

                </a>

            </div>
            <!-- Right Sidebar End -->

        </div>

    </div>
    ```

</div>
<!-- Shipment History End -->
<!-- Need Help Start -->

<div class="wshipping-content-block get-quote">

    ```
    <div class="container">

        <div class="row">

            <div class="col-12 col-lg-8">

                <h4>

                    We Are Always Here,

                    <span>
                        Need Any Help?
                    </span>

                </h4>

            </div>


            <div class="col-12 col-lg-4 text-right">

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="wshipping-button">

                    Contact With Us

                </a>

            </div>

        </div>

    </div>
    ```

</div>
<!-- Need Help End -->
<!-- Our Services Start -->

<div class="wshipping-content-block">

    ```
