                <div class="single-service-item wow fadeInUp">

                    <div class="service-item-bg service-bg-2">
                    </div>

                    <div class="service-content">

                        <h3>
                            Air Freight Shipping
                        </h3>

                        <p>
                            Fast and secure air freight shipping
                            for urgent deliveries.
                        </p>

                        <a href="#"
                           class="readmore-btn">

                            Read More

                            <i class="fa fa-angle-right">
                            </i>

                        </a>

                        <div class="location_map">

                            <i class="fa fa-plus">
                            </i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Road Freight -->
            <div class="col-12 col-lg-4">

                <div class="single-service-item wow fadeInUp">

                    <div class="service-item-bg service-bg-3">
                    </div>

                    <div class="service-content">

                        <h3>
                            Road Freight Shipping
                        </h3>

                        <p>
                            Flexible and reliable road transportation
                            for local and regional shipments.
                        </p>

                        <a href="#"
                           class="readmore-btn">

                            Read More

                            <i class="fa fa-angle-right">
                            </i>

                        </a>

                        <div class="location_map">

                            <i class="fa fa-plus">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    ```

</div>
<!-- Our Services End -->
