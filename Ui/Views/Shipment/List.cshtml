@model DAL.Models.PagedResult<ShipmentDTO>

<!-- Breadcrumbs Start -->

<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">

    <div class="container">

        <div class="row">

            <div class="col-12 col-lg-7">

                <h1>
                    Shipment History
                </h1>

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

                <span> / Shipment History</span>

            </div>


            <div class="col-12 col-lg-5 text-right">

                <h4>

                    We freight to all over the world.
                    The best logistic company,

                    <span>FAST</span>
                    and
                    <span>SAFELY!</span>

                </h4>

            </div>

        </div>

    </div>

</div>
<!-- Breadcrumbs End -->
<!-- Shipment History Start -->

<div class="wshipping-content-block">

    <div class="container">

        <div class="row">


            <!-- Main Content -->
            <div class="col-12 col-lg-9">

                <div class="order-list">


                    <!-- Page Header -->
                    <div class="row align-items-center mb-4">

                        <div class="col-12 col-md-8">

                            <h3>
                                Shipment Management
                            </h3>

                            <p>
                                Monitor and manage your shipments.
                            </p>

                        </div>


                        <div class="col-12 col-md-4 text-md-right">

                            <a asp-controller="Shipment"
                               asp-action="Create"
                               class="wshipping-button">

                                <i class="fa fa-plus">
                                </i>

                                New Shipment

                            </a>

                        </div>

                    </div>


                    @if (Model != null && Model.Items != null && Model.Items.Any())
                    {

                        <!-- Shipment Table -->
                        <div class="table-responsive">

                            <table class="table">

                                <thead>

                                    <tr>

                                        <th>
                                            Shipment
                                        </th>

                                        <th>
                                            Route
                                        </th>

                                        <th>
                                            Schedule
                                        </th>

                                        <th>
                                            Package
                                        </th>

                                        <th>
                                            Cost
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var shipment in Model.Items)
                                    {

                                        <tr>


                                            <!-- Shipment Identity -->
                                            <td>

                                                <strong>

                                                    #@shipment.TrackingNumber

                                                </strong>

                                                <br />

                                                <small>

                                                    Shipment ID:
                                                    @shipment.Id

                                                </small>

                                            </td>


                                            <!-- Route -->
                                            <td>

                                                <div>

                                                    <strong>

                                                        @(shipment.Sender?.SenderName ?? "Unknown Sender")

                                                    </strong>

                                                </div>


                                                <div class="mt-1 mb-1">

                                                    <i class="fa fa-long-arrow-right">
                                                    </i>

                                                </div>


                                                <div>

                                                    <strong>

                                                        @(shipment.Receiver?.ReceiverName ?? "Unknown Receiver")

                                                    </strong>

                                                </div>

                                            </td>


                                            <!-- Schedule -->
                                            <td>

                                                <div>
                                                    <small>Shipping</small>

                                                    <br />

                                                    <strong>
                                                        @shipment.ShippingDate.ToString("dd MMM yyyy")
                                                    </strong>
                                                </div>

                                                <div class="mt-2">
                                                    <small>Delivery</small>

                                                    <br />

                                                    <strong>
                                                        @if (shipment.DeliveryDate != DateTime.MinValue)
                                                        {
                                                            @shipment.DeliveryDate.ToString("dd MMM yyyy")
                                                        }
                                                        else
                                                        {
                                                            <span>Pending</span>
                                                        }
                                                    </strong>
                                                </div>

                                            </td>

                                            <!-- Package -->
                                            <td>

                                                <strong>

                                                    @shipment.Weight kg

                                                </strong>

                                                <br />

                                                <small>

                                                    @shipment.Length ×
                                                    @shipment.Width ×
                                                    @shipment.Height cm

                                                </small>

                                            </td>


                                            <!-- Cost -->
                                            <td>

                                                <strong>

                                                    @shipment.ShipingRate.ToString("C")

                                                </strong>

                                            </td>


                                            <!-- Status -->
                                            <td>

                                                @if (shipment.DeliveryDate != DateTime.MinValue &&
                                                                                        shipment.DeliveryDate < DateTime.Now)
                                                {
                                                    <span class="badge badge-success">

                                                        Delivered

                                                    </span>
                                                }
                                                else if (shipment.ShippingDate <= DateTime.Now)
                                                {
                                                    <span class="badge badge-warning">

                                                        In Transit

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">

                                                        Pending

                                                    </span>
                                                }

                                            </td>


                                            <!-- Action -->
                                            <td>

                                                <a asp-controller="Shipment"
                                                   asp-action="Details"
                                                   asp-route-id="@shipment.Id"
                                                   class="btn btn-sm"
                                                   title="View Shipment Details">

                                                    <i class="fa fa-eye">
                                                    </i>

                                                </a>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        <!-- Pagination Controls -->
                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <span>
                                Page @Model.PageNumber of @Model.TotalPages
                                (Total Shipments: @Model.TotalCount)
                            </span>

                            <div>

                                @if (Model.HasPreviousPage)
                                {
                                    <a class="wshipping-button"
                                       asp-controller="Shipment"
                                       asp-action="List"
                                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                                       asp-route-pageSize="@Model.PageSize">

                                        Previous

                                    </a>
                                }

                                @if (Model.HasNextPage)
                                {
                                    <a class="wshipping-button"
                                       asp-controller="Shipment"
                                       asp-action="List"
                                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                                       asp-route-pageSize="@Model.PageSize">

                                        Next

                                    </a>
                                }

                            </div>

                        </div>

                    }
                    else
                    {

                        <!-- Empty State -->
                        <div class="text-center">

                            <i class="fa fa-truck fa-3x">
                            </i>

                            <h4>

                                No Shipments Found

                            </h4>

                            <p>

                                You currently have no shipments.

                            </p>

                            <a asp-controller="Shipment"
                               asp-action="Create"
                               class="wshipping-button">

                                Create Shipment

                            </a>

                        </div>

                    }

                </div>

            </div>


            <!-- Right Sidebar Start -->
            <div class="col-12 col-lg-3">

                <div class="right-block left-menu menu-with-title mt60 mb15">

                    <h4 class="title-with-bg">

                        Shipment Services

                    </h4>


                    <ul>

                        <li class="active">

                            <a href="#">

                                <i class="fa fa-search">
                                </i>

                                Track Shipment

                            </a>

                        </li>


                        <li>

                            <a href="#">

                                <i class="fa fa-history">
                                </i>

                                Shipment History

                            </a>

                        </li>


                        <li>

                            <a asp-controller="Shipment"
                               asp-action="Create">

                                <i class="fa fa-plus">
                                </i>

                                Create Shipment

                            </a>

                        </li>

                    </ul>

                </div>


                <a asp-controller="Shipment"
                   asp-action="Create"
                   class="order-list-button">

                    Create New Shipment

                </a>

            </div>
            <!-- Right Sidebar End -->

        </div>

    </div>

</div>
<!-- Shipment History End -->
<!-- Send Free Quote Start -->

<div class="wshipping-content-block get-quote">

    <div class="container">

        <div class="row">

            <div class="col-12 col-lg-8">

                <h4>

                    We Are Always Here,

                    <span>
                        Need Any Help?
                    </span>

                </h4>

            </div>


            <div class="col-12 col-lg-4 text-right">

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="wshipping-button">

                    Contact With Us

                </a>

            </div>

        </div>

    </div>

</div>
<!-- Send Free Quote End -->
<!-- Our Services Start -->

<div class="wshipping-content-block">

    <div class="container">

        <div class="row">

            <div class="col-12 col-lg-6 offset-lg-3">

                <div class="section-title wow fadeInUp">

                    <h2>
                        Our Services
                    </h2>

                    <p>
                        Reliable logistics solutions for
                        all your shipping needs.
                    </p>

                </div>

            </div>

        </div>


        <div class="row">


            <!-- Ocean Freight -->
            <div class="col-12 col-lg-4">

                <div class="single-service-item wow fadeInUp">

                    <div class="service-item-bg service-bg-1">
                    </div>

                    <div class="service-content">

                        <h3>
                            Ocean Freight Shipping
                        </h3>

                        <p>
                            Reliable international ocean freight
                            solutions for your shipments.
                        </p>

                        <a href="#"
                           class="readmore-btn">

                            Read More

                            <i class="fa fa-angle-right">
                            </i>

                        </a>

                        <div class="location_map">

                            <i class="fa fa-plus">
                            </i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Air Freight -->
            <div class="col-12 col-lg-4">

                <div class="single-service-item wow fadeInUp">

                    <div class="service-item-bg service-bg-2">
                    </div>

                    <div class="service-content">

                        <h3>
                            Air Freight Shipping
                        </h3>

                        <p>
                            Fast and secure air freight
                            for time-sensitive deliveries.
                        </p>

                        <a href="#"
                           class="readmore-btn">

                            Read More

                            <i class="fa fa-angle-right">
                            </i>

                        </a>

                        <div class="location_map">

                            <i class="fa fa-plus">
                            </i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Road Freight -->
            <div class="col-12 col-lg-4">

                <div class="single-service-item wow fadeInUp">

                    <div class="service-item-bg service-bg-3">
                    </div>

                    <div class="service-content">

                        <h3>
                            Road & Rail Freight
                        </h3>

                        <p>
                            Flexible and reliable transportation
                            for regional shipments.
                        </p>

                        <a href="#"
                           class="readmore-btn">

                            Read More

                            <i class="fa fa-angle-right">
                            </i>

                        </a>

                        <div class="location_map">

                            <i class="fa fa-plus">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Our Services End -->