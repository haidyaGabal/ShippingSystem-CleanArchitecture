<!-- Breadcrumbs Start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Shipment Details</h1>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span> / </span>
                <a asp-controller="Shipment" asp-action="List">Shipment History</a>
                <span> / Details</span>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumbs End -->

<style>
    .shipping-block {
        padding: 40px 0;
    }

    .shipping-form-block {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 35px;
    }

    .shipping-form .form-group {
        margin-bottom: 18px;
    }

    .shipping-form .form-control {
        border-radius: 8px;
        padding: 10px 14px;
    }

    .show-section {
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 25px;
        border: 1px solid rgba(0,0,0,0.08);
    }

        .show-section .fs-title {
            margin-bottom: 18px;
        }

    .what-package img {
        border-radius: 12px;
        width: 100%;
        object-fit: cover;
    }

    .action-button {
        border-radius: 8px;
        padding: 12px 28px;
        margin-top: 8px;
        margin-right: 8px;
    }

    @@media (max-width: 768px) {
        .shipping-form-block {
            padding: 20px;
        }
    }
</style>

<div class="wshipping-content-block shipping-block">
    <div class="container">
        <h2 class="heading2-border mt0">Shipment Details</h2>
        <div class="row">
            <div class="shipping-form-block">
                <form class="steps" id="showShipmentForm">

                    <!-- Tracking -->
                    <div class="show-section">
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Tracking Number</label>
                                        <input type="text" name="TrackingNumber" class="form-control" readonly />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Shipping Date</label>
                                        <input type="date" name="ShippingDate" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Delivery Date</label>
                                        <input type="date" name="DeliveryDate" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sender -->
                    <div class="show-section">
                        <h2 class="fs-title">Ship from</h2>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Country</label>
                                        <select name="Sendercountry" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="SenderName" class="form-control" required maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Contact</label>
                                        <input type="text" name="Contact" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group">
                                        <label>Address</label>
                                        <input type="text" name="Address" class="form-control" required maxlength="500" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Postal Code</label>
                                        <input type="text" name="PostalCode" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>City</label>
                                        <select name="SenderCityId" class="form-control" required></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Other Address Information</label>
                                        <input type="text" name="OtherAddress" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="form-group">
                                        <label>E-mail</label>
                                        <input type="email" name="Email" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="form-group">
                                        <label>Phone</label>
                                        <input type="text" name="Phone" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Receiver -->
                    <div class="show-section">
                        <h2 class="fs-title">Ship to</h2>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Country</label>
                                        <select name="ReceiverCountry" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="ReceiverName" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Contact</label>
                                        <input type="text" name="ReceiverContact" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group">
                                        <label>Address</label>
                                        <input type="text" name="ReceiverAddress" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Postal Code</label>
                                        <input type="text" name="ReceiverPostalCode" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>City</label>
                                        <select name="ReceiverCity" class="form-control" required></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Other Address</label>
                                        <input type="text" name="ReceiverOtherAddress" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="form-group">
                                        <label>E-mail</label>
                                        <input type="email" name="ReceiverEmail" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="form-group">
                                        <label>Phone</label>
                                        <input type="text" name="ReceiverPhone" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Package -->
                    <div class="show-section">
                        <h2 class="fs-title">Package</h2>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-8">
                                    <div class="row">
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Shipping Type</label>
                                                <select name="ShippingType" class="form-control">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Shipping Packaging</label>
                                                <select name="PackageType" class="form-control">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Weight</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Weight" class="form-control" required min="0.01" max="500" />
                                                    <span class="field-comment">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Declared value</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="PackageValue" class="form-control" min="0" max="1000000" />
                                                    <span class="field-comment">USD</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Length</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Length" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Width</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Width" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Height</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Height" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="what-package">
                                        <img src="~/Frontend/assets/images/package.jpg" alt="Package illustration" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <a asp-controller="Shipment" asp-action="List" class="previous action-button">Back to list</a>
                    <input type="submit" class="submit action-button" value="Save Changes" />

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/modules/apphelper.js"></script>
    <script src="~/modules/apiclient.js"></script>
    <script src="~/modules/countriesservice.js"></script>
    <script src="~/modules/cititesservice.js"></script>
    <script src="~/modules/shippingtypesservice.js"></script>
    <script src="~/modules/shippingpackgingservice.js"></script>
    <script src="~/modules/shipment/shipmentservice.js"></script>
    <script src="~/modules/shipment/managepagecontrols.js"></script>
    <script src="~/modules/shipment/managepagecontrols.js"></script>
    <script src="~/modules/shipment/pageevents.js"></script>
    <script src="~/modules/shipment/show.js"></script>

    <script>
        $('#showShipmentForm').on('submit', function (e) {
            e.preventDefault();
            ShipmentService.EditShippment();
        });
    </script>
}