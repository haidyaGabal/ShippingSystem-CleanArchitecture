<!-- Breadcroumbs end -->
<style>
    /* Structural polish only — no new colors, just spacing/shape */
    .shipping-block { padding: 40px 0; }
    .shipping-form-block {
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 35px;
    }
    #progressbar { display: flex; justify-content: space-between; padding: 0; margin-bottom: 35px; }
    #progressbar li { list-style: none; text-align: center; flex: 1; font-size: 13px; }
    .shipping-form .form-group { margin-bottom: 18px; }
    .shipping-form .form-control { border-radius: 8px; padding: 10px 14px; }
    .review, .ship-address {
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 15px;
    }
    .what-package img {
        border-radius: 12px;
        width: 100%;
        object-fit: cover;
    }
    .action-button { border-radius: 8px; padding: 12px 28px; margin-top: 8px; margin-right: 8px; }
    .tanks-message { text-align: center; margin: 40px 0; }
    media (max-width: 768px) {
        .shipping-form-block { padding: 20px; }
    }
</style>

<!-- Create New Shipment Start -->
<div class="wshipping-content-block shipping-block">
    <div class="container">
        <h2 class="heading2-border mt0">Create New Shipping</h2>
        <div class="row">
            <div class="shipping-form-block">
                <form class="steps" enctype="multipart/form-data">
                    <!-- progressbar -->
                    <ul id="progressbar">
                        <li class="active">Where From</li>
                        <li>Where Going</li>
                        <li>Package</li>
                        <li>Review</li>
                        <li>Complete</li>
                    </ul>

                    <!-- fieldsets Shipping From Start-->
                    <fieldset>
                        <h2 class="fs-title">Hello. Where are you shipping from?</h2>
                        <h3 class="fs-subtitle">* Indicates required field</h3>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Country <sup>*</sup></label>
                                        <select name="Sendercountry" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Name <sup>*</sup></label>
                                        <input type="text" name="SenderName" class="form-control" required minlength="1" maxlength="100" />
                                        <span class="error1" style="display: none;"> <i class="error-log fa fa-exclamation-triangle"></i> </span>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Contact <sup>*</sup></label>
                                        <input type="text" name="Contact" class="form-control" required />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-12">
                                    <div class="form-group">
                                        <label>Address <sup>*</sup></label>
                                        <input type="text" name="Address" class="form-control" required minlength="5" maxlength="500" placeholder="Street Address" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Postal Code <sup>*</sup></label>
                                        <input type="text" name="PostalCode" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>City <sup>*</sup></label>
                                        <select name="SenderCityId" class="form-control" required></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Other Address Information</label>
                                        <input type="text" name="OtherAddress" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>E-mail <sup>*</sup></label>
                                        <input type="email" name="Email" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Phone <sup>*</sup></label>
                                        <input type="text" name="Phone" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Shipping Date <sup>*</sup></label>
                                        <input type="date" name="ShippingDate" class="form-control" required />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label class="slide-label">Use this as my default address</label>
                                        <div class="slide-redio">
                                            <input type="checkbox" value="None" id="IsDefaultSender" name="check" checked />
                                            <label for="slide-radio2"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="button" name="next" class="next action-button" value="Continue" />
                        <input type="reset" name="cancel" class="action-button btn-red" value="Cancel Shipment" />
                    </fieldset>
                    <!-- fieldsets Shipping From end-->

                    <!-- fieldsets Shipping going Start-->
                    <fieldset>
                        <h2 class="fs-title">Where is your shipping going?</h2>
                        <div class="row">
                            <div class="col-12 col-lg-6">
                                <div class="ship-address">
                                    <h4>Ship from <a href="#" title="Edit" class="btn-edit">Edit</a></h4>
                                    <p>Confirm sender details before continuing</p>
                                </div>
                            </div>
                        </div>
                        <h3 class="fs-subtitle">* Indicates required field</h3>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Country <sup>*</sup></label>
                                        <select name="ReceiverCountry" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Name <sup>*</sup></label>
                                        <input type="text" name="ReceiverName" class="form-control" required />
                                        <span class="error1" style="display: none;"> <i class="error-log fa fa-exclamation-triangle"></i> </span>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Contact <sup>*</sup></label>
                                        <input type="text" name="ReceiverContact" class="form-control" required />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-12">
                                    <div class="form-group">
                                        <label>Address <sup>*</sup></label>
                                        <input type="text" name="ReceiverAddress" class="form-control" required placeholder="Street Address" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Postal Code <sup>*</sup></label>
                                        <input type="text" name="ReceiverPostalCode" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>City <sup>*</sup></label>
                                        <select name="ReceiverCity" class="form-control" required></select>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Other Address</label>
                                        <input type="text" name="ReceiverOtherAddress" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>E-mail <sup>*</sup></label>
                                        <input type="email" name="ReceiverEmail" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Phone <sup>*</sup></label>
                                        <input type="text" name="ReceiverPhone" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Expected Delivery Date</label>
                                        <input type="date" name="DeliveryDate" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="button" name="previous" class="previous action-button" value="Previous" />
                        <input type="button" name="next" class="next action-button" value="Continue" />
                        <input type="reset" name="cancel" class="action-button btn-red" value="Cancel Shipment" />
                    </fieldset>
                    <!-- fieldsets Shipping going end-->

                    <!-- fieldsets package Start-->
                    <fieldset>
                        <h2 class="fs-title">What kind of packaging are you using?</h2>
                        <h3 class="fs-subtitle">* Indicates required field</h3>
                        <div class="shipping-form">
                            <div class="row">
                                <div class="col-12 col-lg-8">
                                    <div class="row">
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Shipping Type</label>
                                                <div class="input-comment">
                                                    <select name="ShippingType" class="form-control">
                                                        <option></option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <div class="form-group">
                                                <label>Weight <sup>*</sup></label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Weight" class="form-control" required min="0.01" max="500" />
                                                    <span class="error1" style="display: none;"> <i class="error-log fa fa-exclamation-triangle"></i> </span>
                                                    <span class="field-comment">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Length <sup>*</sup></label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Length" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Width <sup>*</sup></label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Width" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Height <sup>*</sup></label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="Height" class="form-control" required min="0.1" max="1000" />
                                                    <span class="field-comment">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-12 col-lg-4">
                                            <div class="form-group">
                                                <label>Declared value</label>
                                                <div class="input-comment">
                                                    <input type="number" step="0.01" name="PackageValue" class="form-control" min="0" max="1000000" />
                                                    <span class="field-comment">USD</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="what-package"><img src="~/Frontend/assets/images/package.jpg" alt="Package illustration" /></div>
                                </div>
                            </div>
                        </div>
                        <input type="button" name="previous" class="previous action-button" value="Previous" />
                        <input type="button" name="next" class="next action-button" value="Continue" />
                        <input type="reset" name="cancel" class="action-button btn-red" value="Cancel Shipment" />
                    </fieldset>
                    <!-- fieldsets package end-->

                    <!-- fieldsets Review Start-->
                    <fieldset>
                        <h2 class="fs-title">Let's make sure everything is in order</h2>
                        <div class="shipping-form">
                            <div class="review">
                                <h3>Where <a href="#" title="Edit" class="btn-edit">Edit</a></h3>
                                <div class="row">
                                    <div class="col-12 col-lg-6">
                                        <div class="ship-address">
                                            <h4>Ship from</h4>
                                            <p id="reviewSender">—</p>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6">
                                        <div class="ship-address">
                                            <h4>Ship to</h4>
                                            <p id="reviewReceiver">—</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="review">
                                <h3>Package <a href="#" title="Edit" class="btn-edit">Edit</a></h3>
                                <ul>
                                    <li><b>Weight:</b> <span id="reviewWeight">—</span> kg</li>
                                    <li><b>Dimensions:</b> <span id="reviewDimensions">—</span> cm</li>
                                    <li><b>Declared value:</b> $<span id="reviewValue">—</span></li>
                                    <li><b>Shipping rate:</b> $<span id="reviewRate">—</span></li>
                                </ul>
                            </div>
                            <div class="review">
                                <div class="checkbox">
                                    <input type="checkbox" name="remember" id="trems" class="css-checkbox" required />
                                    <label for="trems" class="css-label">I confirm the shipment details above are correct and agree to the terms of service.</label>
                                </div>
                            </div>
                        </div>
                        <input type="button" name="previous" class="previous action-button" value="Previous" />
                        <input type="button" name="next" class="next action-button" value="Continue" />
                    </fieldset>
                    <!-- fieldsets Review end-->

                    <!-- fieldsets Complete Start-->
                    <fieldset>
                        <div class="shipping-form">
                            <h1 class="tanks-message">Thank You For Creating Shipment</h1>
                        </div>
                        <input type="submit" name="submit" class="submit action-button" value="Submit" />
                    </fieldset>
                    <!-- fieldsets Complete end-->

                </form>
            </div>
        </div>
    </div>
</div>
<!-- Create New Shipment end -->

@section Scripts
{
    <script src="~/modules/apphelper.js"></script>
    <script src="~/modules/apiclient.js"></script>
    <script src="~/modules/countriesservice.js"></script>
    <script src="~/modules/cititesservice.js"></script>
    <script src="~/modules/shippingtypesservice.js"></script>
    <script src="~/modules/shippingpackgingservice.js"></script>
    <script src="~/modules/shipment/shipmentservice.js"></script>
    <script src="~/modules/shipment/managepagecontrols.js"></script>
    <script src="~/modules/shipment/pageevents.js"></script>
    <script src="~/modules/shipment/create.js"></script>
}